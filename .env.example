# ==============================================================================
# NEXORA ENVIRONMENT CONFIGURATION
# Created by Parmanand Sharma
# ==============================================================================

# Application Branding
PROJECT_NAME="Nexora"
CREATOR="Parmanand Sharma"
TAGLINE="Learn Smarter. Grow Faster."
ENVIRONMENT="development"

# Security (Generate a 64+ char random string for production)
JWT_SECRET="nexora_development_secret_key_change_me_before_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./nexora.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://nexora_user:password@localhost:5432/nexora_db"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# File Uploads
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# Optional External AI (Strictly opt-in, disabled by default)
ENABLE_EXTERNAL_AI=false
OPENAI_API_KEY=""

# Frontend (for production builds)
VITE_API_BASE_URL="/api"
