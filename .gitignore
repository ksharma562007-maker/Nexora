# ==============================================================================
# NEXORA Smart Learning - Git Ignore Configuration
# ==============================================================================

# Node Dependencies
node_modules/
*/node_modules/
frontend/node_modules/

# Frontend Build & Cache
dist/
*/dist/
frontend/dist/
build/
.vite/
*/.vite/
frontend/.vite/
.vercel/

# Python Virtual Environments
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
*/venv/
*/.venv/

# Python Bytecode & Cache
__pycache__/
*/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# Local Database Files
*.db
*.sqlite
*.sqlite3
nexora.db
backend/nexora.db
test_nexora*.db

# Uploaded Files & Temporary Directories
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
scratch/
scratch_test/

# Environment Files & Secrets (Exclude actual env files, preserve examples)
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor Files
.DS_Store
Thumbs.db
*.swp
*.swo
